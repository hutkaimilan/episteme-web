# EPISTEME — environment variables
# Copy to .env.local for local development; set in Vercel project settings for production.

# REQUIRED, server-side only. Used exclusively by the AI receptionist route
# (src/app/api/chat/route.ts). Never expose this to the client.
# Get a free-tier key from the Groq Console (https://console.groq.com) —
# no card required, no EU restriction; the route calls the
# llama-3.3-70b-versatile model via Groq's OpenAI-compatible API.
GROQ_API_KEY=

# REQUIRED for the Retell AI voice agent's booking functions endpoint
# (/api/retell/functions). Any long random string; the same value goes into
# the function URL (?secret=...) or x-retell-secret header configured in the
# Retell dashboard. See RETELL_SETUP.md.
RETELL_FUNCTION_SECRET=

# REQUIRED for the demo/admin reset endpoint (/api/admin/reset). Any long
# random string; present it via the x-admin-secret header (POST to reset) or
# ?secret=... query (GET for the occupancy snapshot). Without it the endpoint
# refuses to run (503) — a booking-mutating endpoint is never silently open.
ADMIN_RESET_SECRET=

# Vercel KV (Redis) — booking storage. When BOTH are set, reservations persist
# in KV, shared across all serverless instances; without them the app falls
# back to per-process in-memory storage (fine for local dev / CI, NOT for
# production). Create a KV/Redis store in the Vercel dashboard (Storage tab) and
# "Connect" it to the project — Vercel injects these automatically on deploy.
# For local use, run `vercel env pull .env.local` after connecting.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Leonardo AI Production API key — get from app.leonardo.ai API section.
# Put the real value in .env.local, never commit it. Used only by
# scripts/generate-menu-images.js (menu image regeneration), not by the app.
LEONARDO_API_KEY=

# --- Transactional e-mail (server-side EmailJS) ------------------------------
# Used by src/lib/email.ts for the guest's booking confirmation and for the
# cancellation notice that goes to BOTH the guest and the restaurant. These
# run on the SERVER (via EmailJS's REST API), because a cancellation must be
# delivered even when it arrives through the Retell voice agent, where no
# browser is involved at all.
#
# ONE shared template covers both letters (the EmailJS free plan allows a
# single template). The dashboard template stays "dumb" — it only renders
# {{subject}} and {{message_body}} to {{to_email}} — and the actual wording of
# both mails is composed in src/lib/email.ts, where it is version-controlled
# and unit-tested.
#
# Setup (see EMAIL_SETUP.md for the click-by-click walkthrough):
#   1. EmailJS dashboard → Account → General: copy the Public Key and the
#      PRIVATE Key (https://dashboard.emailjs.com/admin/account).
#   2. Account → Security: enable "Allow EmailJS API for non-browser
#      applications" — without it every server-side send returns 403.
#   3. Create ONE template with To Email = {{to_email}}, Subject =
#      {{subject}} and a body containing only {{message_body}}.
#
# When any of these is missing the app still runs: bookings and cancellations
# succeed normally and the send is skipped with an [EMAIL_SKIPPED] log line.
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_TEMPLATE_ID=

# NOTE: a separate, older EmailJS path also exists client-side (service ID,
# template ID and public key as constants in
# src/components/ReservationSection.tsx). It sends to whatever fixed recipient
# its dashboard template defines and is untouched by the variables above —
# see EMAIL_SETUP.md if you want to retire it.
